    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiled-ts/core": "workspace:*",
    "fast-xml-parser": "^4.5.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
