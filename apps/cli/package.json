{
  "name": "@tiled-ts/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of Tiled's tmxrasterizer CLI.",
  "bin": {
    "tiled-ts": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "types": "./dist/bin.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiled-ts/core": "workspace:*",
    "@tiled-ts/format": "workspace:*",
    "@tiled-ts/render-math": "workspace:*",
    "@napi-rs/canvas": "^0.1.56"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
