{
  "name": "tiled-ts",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript port of the Tiled map editor (https://github.com/mapeditor/tiled)",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @tiled-ts/editor dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@11.1.2"
}
